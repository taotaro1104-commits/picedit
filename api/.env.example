# Replicate の API トークン（未設定なら AI 機能＝高解像度化・カラー化・顔の復元 はオフになる）
REPLICATE_API_TOKEN=

# 使用するモデル（owner/name）。差し替える場合は app/providers/replicate_provider.py の build_input も合わせる
REPLICATE_MODEL_UPSCALE=nightmareai/real-esrgan
REPLICATE_MODEL_COLORIZE=piddnad/ddcolor
REPLICATE_MODEL_FACE_RESTORE=tencentarc/gfpgan
REPLICATE_TIMEOUT_SECONDS=180

# アップロード制限
MAX_UPLOAD_BYTES=20971520
MAX_SIDE_PIXELS=8000

# フロントエンドのオリジン（JSON 配列）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
